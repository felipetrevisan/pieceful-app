UNSPLASH_ACCESS_KEY=
# URL do frontend, sem necessidade de incluir /admin. Separe mais de uma origem com vírgulas.
# Barras finais e caminhos são normalizados automaticamente.
WEB_ORIGIN=http://localhost:3000

# Pieceful Studio (/admin). Nunca exponha estas variáveis no frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# RevenueCat secret key used only by the API to verify non-subscription purchases.
REVENUECAT_SECRET_API_KEY=sk_your_revenuecat_secret_key
REVENUECAT_WEBHOOK_SIGNING_SECRET=generate-in-the-revenuecat-dashboard
REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer generate-a-separate-random-secret
PIECEFUL_ADMIN_SESSION_SECRET=generate-at-least-32-random-bytes
# Admin users need app_metadata.role=admin and an enrolled TOTP factor.
PIECEFUL_ADMIN_REQUIRE_MFA=true
# Configure only the header guaranteed by your reverse proxy (for example,
# cf-connecting-ip). Vercel and Cloudflare are detected automatically.
TRUSTED_PROXY_IP_HEADER=
API_RATE_LIMIT_SECRET=generate-at-least-32-random-bytes
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
APP_ENV=development
APP_RELEASE=
