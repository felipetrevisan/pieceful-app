EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
EXPO_PUBLIC_API_URL=https://api.your-pieceful-domain.com
# Configure an HTTPS Universal Link/App Link after publishing the platform
# association files. The custom scheme remains a local-development fallback.
EXPO_PUBLIC_AUTH_CALLBACK_URL=pieceful://auth/callback
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_RELEASE=
SENTRY_ORG=
SENTRY_PROJECT=
# Build-secret only; configure in EAS/CI, never with EXPO_PUBLIC_.
SENTRY_AUTH_TOKEN=

# Monetization (Android / Google Play). RevenueCat uses the public Android SDK key.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_public_sdk_key
EXPO_PUBLIC_ADMOB_REWARDED_HINT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
# Optional: use a separate rewarded unit for 24-hour theme unlocks.
EXPO_PUBLIC_ADMOB_REWARDED_THEME_ID=ca-app-pub-xxxxxxxxxxxxxxxx/zzzzzzzzzz
# Optional: use a separate rewarded unit for the "highlight pieces" board tool.
# Falls back to EXPO_PUBLIC_ADMOB_REWARDED_HINT_ID when unset.
EXPO_PUBLIC_ADMOB_REWARDED_HIGHLIGHT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/wwwwwwwwww
# Required for production: the app's real AdMob App IDs from the AdMob
# console. Unset, app.config.js falls back to Google's public sample App IDs
# (fine for development/preview, must not ship to production).
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~zzzzzzzzzz

# Google Play Games Services project and achievement IDs from Play Console.
EXPO_PUBLIC_GOOGLE_PLAY_GAMES_APP_ID=000000000000
EXPO_PUBLIC_PLAY_GAMES_FIRST_PUZZLE=
EXPO_PUBLIC_PLAY_GAMES_NO_HINTS=
EXPO_PUBLIC_PLAY_GAMES_PIECES_250=
EXPO_PUBLIC_PLAY_GAMES_PUZZLES_10=

# These defaults may be changed to match the identifiers in App Store Connect.
EXPO_PUBLIC_GAME_CENTER_FIRST_PUZZLE=app.perazzo.pieceful.first_puzzle
EXPO_PUBLIC_GAME_CENTER_NO_HINTS=app.perazzo.pieceful.no_hints
EXPO_PUBLIC_GAME_CENTER_PIECES_250=app.perazzo.pieceful.pieces_250
EXPO_PUBLIC_GAME_CENTER_PUZZLES_10=app.perazzo.pieceful.puzzles_10
